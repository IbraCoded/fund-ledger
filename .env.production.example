DJANGO_ENV=production
DJANGO_SECRET_KEY=
# The public domain, plus "localhost" for the container health check and "api" for Prometheus.
DJANGO_ALLOWED_HOSTS=ledger.example.com,localhost,api
DOMAIN=ledger.example.com
IMAGE=ghcr.io/<your-github-username-lowercase>/fund-ledger
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=
POSTGRES_HOST=db
APP_DB_USER=ledger_app
APP_DB_PASSWORD=
LOG_FORMAT=json
GUNICORN_WORKERS=3
GRAFANA_ADMIN_PASSWORD=
