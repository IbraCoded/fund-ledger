{$DOMAIN} {
    encode zstd gzip

    # Ledger requests are tiny. Refuse large bodies at the edge.
    request_body {
        max_size 256KB
    }

    # Prometheus scrapes api:8000/metrics on the private network; the public gets nothing.
    @metrics path /metrics
    respond @metrics 404

    # A visitor who types the bare domain lands on the interactive docs.
    redir / /api/docs/ 302

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    # The API only ever returns JSON/CSV: forbid it from loading anything at all.
    # (Swagger UI needs scripts from a CDN, so its page is exempt.)
    @not_docs not path /api/docs/*
    header @not_docs Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"

    reverse_proxy api:8000
}
